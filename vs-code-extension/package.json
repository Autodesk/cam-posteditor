				"AutodeskPostUtility.customMachineLocations": {
					"type": "object",
					"description": "Object containing custom machine folder locations (managed by Add custom machine folder)"
				},
				"AutodeskPostUtility.showWarningMessages": {
					"type": "boolean",
					"default": false,
					"description": "If true, you will be notified when the log file includes warning messages"
				},
				"AutodeskPostUtility.qaTestEnabled": {
					"type": "boolean",
					"default": false,
