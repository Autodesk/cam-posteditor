					"type": "boolean",
					"default": false,
					"description": "If true, two clicks are required for line jumping"
				},
				"AutodeskPostUtility.navigateToPostAtLineOnNcClick": {
					"type": "boolean",
					"default": true,
					"description": "If true, clicking a line in the debug NC output navigates to the post at the corresponding line. F12 (Go to Definition) and hover call stack always work regardless of this setting."
				},
				"AutodeskPostUtility.showCallStackOnHover": {
					"type": "boolean",
