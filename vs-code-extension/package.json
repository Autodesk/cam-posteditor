{
	"name": "hsm-post-processor",
	"displayName": "Autodesk Fusion Post Processor Utility",
	"description": "Post processor utility for editing, testing, and debugging Autodesk Fusion post processors.",
	"version": "5.0.3",
	"icon": "res/icons/logo.png",
	"author": {
		"name": "Autodesk",
		"email": "cam.posts@autodesk.com",
		"url": "https://cam.autodesk.com"
	},
	"publisher": "Autodesk",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"contributes": {
		"languages": [
			{
				"id": "nccode",
				"aliases": [
					"nccode",
					"gcode"
				],
				"extensions": [
					".nc",
					".tap",
					".cnc",
					".gc",
					".mpf",
					".spf",
					".h"
				],
				"configuration": "./res/language-configuration.json"
			},
			{
				"id": "qatest-log",
				"aliases": [
					"QA test log"
				]
			}
		],
		"grammars": [
			{
				"language": "nccode",
				"scopeName": "source.nccode",
				"path": "./syntaxes/nccode.tmLanguage.json"
			},
			{
				"language": "qatest-log",
				"scopeName": "text.log.qatest",
				"path": "./syntaxes/qatest-log.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "autodesk.post.functionList.refresh",
				"title": "Reload the list of post processor functions from the current file",
				"shortTitle": "Refresh functions",
				"icon": {
					"dark": "res/icons/ref.svg",
					"light": "res/icons/ref.svg"
				}
			},
			{
				"command": "autodesk.post.functionList.filter",
				"title": "Search functions",
				"shortTitle": "Search...",
				"icon": "$(search)"
			},
			{
				"command": "autodesk.post.functionList.clearFilter",
				"title": "Clear the search filter and show all functions",
				"shortTitle": "Clear search",
				"icon": "$(clear-all)"
			},
			{
				"command": "autodesk.post.disableLineSelection",
				"title": "Disable auto line selection",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.showDebuggedCode",
				"title": "Show debugged code",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.cncList.addFolder",
				"title": "Add a custom folder to the CNC file list",
				"shortTitle": "Add folder",
				"icon": {
					"dark": "res/icons/add.svg",
					"light": "res/icons/add.svg"
				}
			},
			{
				"command": "autodesk.post.cncList.filter",
				"title": "Search CNC files",
				"shortTitle": "Search...",
				"icon": "$(search)"
			},
			{
				"command": "autodesk.post.cncList.clearFilter",
				"title": "Clear the search filter and show all CNC files",
				"shortTitle": "Clear search",
				"icon": "$(clear-all)"
			},
			{
				"command": "autodesk.post.machineList.addFolder",
				"title": "Add a custom folder to the machine list",
				"shortTitle": "Add folder",
				"icon": {
					"dark": "res/icons/add.svg",
					"light": "res/icons/add.svg"
				}
			},
			{
				"command": "autodesk.post.machineList.filter",
				"title": "Search machines",
				"shortTitle": "Search...",
				"icon": "$(search)"
			},
			{
				"command": "autodesk.post.machineList.clearFilter",
				"title": "Clear the search filter and show all machines",
				"shortTitle": "Clear search",
				"icon": "$(clear-all)"
			},
			{
				"command": "autodesk.post.machineList.filterOnlineLibrary",
				"title": "Filter machines by axis, purpose, kinematics, vendor, TCP (from .mch)",
				"shortTitle": "Filter machines...",
				"icon": "$(filter)"
			},
			{
				"command": "autodesk.post.updateOnlineLibrary",
				"title": "Update Online Library",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.propertyList.refresh",
				"title": "Load or reload post properties from the current post file",
				"shortTitle": "Initialize Property List",
				"icon": {
					"dark": "res/icons/ref.svg",
					"light": "res/icons/ref.svg"
				}
			},
			{
				"command": "autodesk.post.propertyList.applyMachineDefaults",
				"title": "Apply property defaults from the selected machine",
				"shortTitle": "Apply Machine Defaults",
				"icon": {
					"light": "res/icons/machine-light.svg",
					"dark": "res/icons/machine-dark.svg"
				}
			},
			{
				"command": "autodesk.post.propertyList.filter",
				"title": "Search post properties",
				"shortTitle": "Search...",
				"icon": "$(search)"
			},
			{
				"command": "autodesk.post.propertyList.clearFilter",
				"title": "Clear the search filter and show all properties",
				"shortTitle": "Clear search",
				"icon": "$(clear-all)"
			},
			{
				"command": "autodesk.post.changeProperty",
				"title": "Change value...",
				"shortTitle": "Change",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.resetProperty",
				"title": "Reset to default",
				"shortTitle": "Reset",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.changePostExe",
				"title": "Change post executable",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.changeSecondaryPostExe",
				"title": "Change secondary post executable",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.setIncludePath",
				"title": "Set include path...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.updatePostProperties",
				"title": "Update post properties for current file...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.installTypeDeclarations",
				"title": "Install IntelliSense type declarations",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.foldPropertyList",
				"title": "Fold property list...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.downloadCNCExtractor",
				"title": "Download CNC exporting post processor",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.encryptPost",
				"title": "Encrypt post processor",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.mergePost",
				"title": "Merge post processor",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.decryptPost",
				"title": "Decrypt post processor",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.importCNC",
				"title": "Import CNC file...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.clearMachineSelection",
				"title": "Clear selected machine...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.importMachine",
				"title": "Import machine file...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.showPostEngineVersion",
				"title": "Show Post Processor Engine Version...",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.showDebugForLine",
				"title": "Post Utility: Debug selected line(s)",
				"category": "Autodesk Post Utility",
				"icon": "$(bug)"
			},
			{
				"command": "autodesk.post.postProcess",
				"title": "Post Process",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.postCompare",
				"title": "Compare post processors",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.regressionTestList.refresh",
				"title": "Refresh",
				"icon": {
					"dark": "res/icons/ref.svg",
					"light": "res/icons/ref.svg"
				}
			},
			{
				"command": "autodesk.post.runRegressionTest",
				"title": "Run regression test",
				"shortTitle": "Run",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.runRegressionAndCompare",
				"title": "Run regression test and compare with reference",
				"shortTitle": "Run and compare",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.createRegressionReferenceFiles",
				"title": "Save selected output as reference",
				"shortTitle": "Create reference",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.compareRegressionWithReference",
				"title": "Compare output with reference",
				"shortTitle": "Compare with reference",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.deleteCNCFolder",
				"title": "Delete folder",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.deleteCNCFile",
				"title": "Delete file",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.deleteMachineFolder",
				"title": "Delete folder",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.deleteMachineFile",
				"title": "Delete machine file",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.editMachineFile",
				"title": "Edit machine file",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.createCNCFolder",
				"title": "New folder",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.createMachineFolder",
				"title": "New folder",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.openFolder",
				"title": "Open folder",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.removeCNCFolderRef",
				"title": "Remove folder from list",
				"category": "Autodesk Post Utility"
			},
			{
				"command": "autodesk.post.removeMachineFolderRef",
				"title": "Remove folder from list",
				"category": "Autodesk Post Utility"
			},
			{ "command": "autodesk.post.qaTest.enable", "title": "Enable QA testing", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.disable", "title": "Disable QA testing", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.run", "title": "Run QA tests", "category": "QA Test", "icon": "$(play)" },
			{ "command": "autodesk.post.qaTest.runActivePost", "title": "Run QA tests for current post", "category": "QA Test", "icon": "$(play)" },
			{ "command": "autodesk.post.qaTest.runPost", "title": "Run QA tests for posts...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.runFolder", "title": "Run QA tests for a folder...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.runAllPosts", "title": "Run QA tests for all posts with test cases", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.runChangedPosts", "title": "Run QA tests for changed posts (staged and unstaged)", "category": "QA Test", "icon": "$(git-commit)" },
			{ "command": "autodesk.post.qaTest.runBranchChanges", "title": "Run QA tests for the changes on this branch...", "category": "QA Test", "icon": "$(git-compare)" },
			{ "command": "autodesk.post.qaTest.checkLibraryEngine", "title": "Check post engine version", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.updateLibraryEngine", "title": "Update post engine", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.runExplorer", "title": "Run QA tests", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.runItem", "title": "Run", "category": "QA Test", "icon": "$(play)" },
			{ "command": "autodesk.post.qaTest.rerunProblems", "title": "Run failed and changed tests again", "category": "QA Test", "icon": "$(debug-rerun)" },
			{ "command": "autodesk.post.qaTest.openJob", "title": "Open result", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.diff", "title": "Compare with expected", "category": "QA Test", "icon": "$(diff)" },
			{ "command": "autodesk.post.qaTest.openOutput", "title": "Open output", "category": "QA Test", "icon": "$(go-to-file)" },
			{ "command": "autodesk.post.qaTest.openExpected", "title": "Open expected output", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.accept", "title": "Accept as expected", "category": "QA Test", "icon": "$(check)" },
			{ "command": "autodesk.post.qaTest.acceptAll", "title": "Accept all new and differing outputs as expected", "category": "QA Test", "icon": "$(check-all)" },
			{ "command": "autodesk.post.qaTest.showOutput", "title": "Show QA test log", "category": "QA Test", "icon": "$(output)" },
			{ "command": "autodesk.post.qaTest.problemsOnly", "title": "Show only problems", "category": "QA Test", "icon": "$(filter)" },
			{ "command": "autodesk.post.qaTest.showAll", "title": "Show all tests", "category": "QA Test", "icon": "$(filter-filled)" },
			{ "command": "autodesk.post.qaTest.refresh", "title": "Refresh", "category": "QA Test", "icon": "$(refresh)" },
			{ "command": "autodesk.post.qaTest.followActivePost", "title": "Back to the current post", "category": "QA Test", "icon": "$(arrow-left)" },
			{ "command": "autodesk.post.qaTest.openSettings", "title": "QA test settings", "category": "QA Test", "icon": "$(gear)" },
			{ "command": "autodesk.post.qaTest.createProject", "title": "Create QA project...", "category": "QA Test", "icon": "$(new-folder)" },
			{ "command": "autodesk.post.qaTest.selectProject", "title": "Use existing QA project folder...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.openProjectFolder", "title": "Open QA project folder", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.addTestCase", "title": "Add test case...", "category": "QA Test", "icon": "$(add)" },
			{ "command": "autodesk.post.qaTest.saveViewProperties", "title": "Save Post Properties view settings as new test case...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.editProperties", "title": "Edit properties...", "category": "QA Test", "icon": "$(settings)" },
			{ "command": "autodesk.post.qaTest.editInputs", "title": "Edit input CNC files...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.editMachine", "title": "Set machine...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.editDescription", "title": "Rename (description)...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.editSuffix", "title": "Change output suffix...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.editAdditionalFlags", "title": "Additional post engine flags...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.toggleIgnored", "title": "Ignore / include test case", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.toggleUseDefaultProperties", "title": "Use / skip default properties (common.json)", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.duplicateTestCase", "title": "Duplicate test case...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.removeTestCase", "title": "Remove test case...", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.openTestCaseJson", "title": "Open test case file (JSON)", "category": "QA Test" },
			{ "command": "autodesk.post.qaTest.useOutsideProject", "title": "Use the QA tests found above this post", "category": "QA Test" }
		],
		"keybindings": [
			{
				"command": "autodesk.post.selectCNCFile",
				"key": "Ctrl+Alt+c"
			},
			{
				"command": "autodesk.post.postProcess",
				"key": "Ctrl+Alt+g"
			}
		],
		"views": {
			"explorer": [
				{
					"id": "functionList",
					"name": "Function List"
				},
				{
					"id": "cncList",
					"name": "CNC Selector"
				},
				{
					"id": "machineList",
					"name": "Machine Selector"
				},
				{
					"id": "propertyList",
					"name": "Post Properties"
				},
				{
					"id": "regressionTestList",
					"name": "Regression test"
				},
				{
					"id": "qaTestList",
					"name": "QA test",
					"when": "config.AutodeskPostUtility.qaTestEnabled"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "qaTestList",
				"contents": "QA tests run your post with a set of test cases (CNC inputs, properties and machines) and compare the output with the expected output.\n[Create QA project](command:autodesk.post.qaTest.createProject)\n[Use existing QA project folder](command:autodesk.post.qaTest.selectProject)\nA post-library \"tests\" folder is found automatically when you open a post from that library.",
				"when": "!autodesk.qaTest.hasProject && !autodesk.qaTest.outsideProject"
			},
			{
				"view": "qaTestList",
				"contents": "This post is outside the open folder, so QA tests found above it are not used automatically.\n[Use these QA tests](command:autodesk.post.qaTest.useOutsideProject)\nThe choice applies until you switch to another post.\n[Create QA project](command:autodesk.post.qaTest.createProject)\n[Use existing QA project folder](command:autodesk.post.qaTest.selectProject)",
				"when": "!autodesk.qaTest.hasProject && autodesk.qaTest.outsideProject"
			},
			{
				"view": "qaTestList",
				"contents": "Open a post (.cps) file to see and run its test cases.\n[Run QA tests for a folder](command:autodesk.post.qaTest.runFolder)\n[Run all posts with test cases](command:autodesk.post.qaTest.runAllPosts)\n[QA test settings](command:autodesk.post.qaTest.openSettings)",
				"when": "autodesk.qaTest.hasProject && !autodesk.qaTest.hasPosts"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "autodesk.post.showDebugForLine",
					"when": "resourceExtname == .cps",
					"group": "1_debug@1"
				}
			],
			"editor/title": [
				{ "command": "autodesk.post.qaTest.accept", "when": "config.AutodeskPostUtility.qaTestEnabled && autodesk.qaTest.canAcceptEditor", "group": "navigation" }
			],
			"view/title": [
				{
					"command": "autodesk.post.functionList.refresh",
					"when": "view == functionList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.functionList.filter",
					"when": "view == functionList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.functionList.clearFilter",
					"when": "view == functionList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.cncList.addFolder",
					"when": "view == cncList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.cncList.filter",
					"when": "view == cncList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.cncList.clearFilter",
					"when": "view == cncList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.machineList.addFolder",
					"when": "view == machineList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.machineList.filter",
					"when": "view == machineList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.machineList.clearFilter",
					"when": "view == machineList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.machineList.filterOnlineLibrary",
					"when": "view == machineList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.propertyList.refresh",
					"when": "view == propertyList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.propertyList.applyMachineDefaults",
					"when": "view == propertyList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.propertyList.filter",
					"when": "view == propertyList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.propertyList.clearFilter",
					"when": "view == propertyList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.compareRegressionWithReference",
					"when": "view == regressionTestList",
					"group": "navigation"
				},
				{
					"command": "autodesk.post.createRegressionReferenceFiles",
					"when": "view == regressionTestList",
					"group": "navigation"
				},
				{ "command": "autodesk.post.qaTest.run", "when": "view == qaTestList && autodesk.qaTest.hasPosts && !autodesk.qaTest.running", "group": "navigation@1" },
				{ "command": "autodesk.post.qaTest.rerunProblems", "when": "view == qaTestList && autodesk.qaTest.hasPosts", "group": "navigation@2" },
				{ "command": "autodesk.post.qaTest.addTestCase", "when": "view == qaTestList && autodesk.qaTest.hasPosts", "group": "navigation@4" },
				{ "command": "autodesk.post.qaTest.runChangedPosts", "when": "view == qaTestList && autodesk.qaTest.libraryMode && !autodesk.qaTest.running", "group": "navigation@3" },
				{ "command": "autodesk.post.qaTest.problemsOnly", "when": "view == qaTestList && !autodesk.qaTest.problemsOnly", "group": "navigation@5" },
				{ "command": "autodesk.post.qaTest.showAll", "when": "view == qaTestList && autodesk.qaTest.problemsOnly", "group": "navigation@5" },
				{ "command": "autodesk.post.qaTest.followActivePost", "when": "view == qaTestList && !autodesk.qaTest.following", "group": "navigation@0" },
				{ "command": "autodesk.post.qaTest.refresh", "when": "view == qaTestList", "group": "navigation@6" },
				{ "command": "autodesk.post.qaTest.runActivePost", "when": "view == qaTestList", "group": "1_run@1" },
				{ "command": "autodesk.post.qaTest.runPost", "when": "view == qaTestList", "group": "1_run@2" },
				{ "command": "autodesk.post.qaTest.runFolder", "when": "view == qaTestList", "group": "1_run@3" },
